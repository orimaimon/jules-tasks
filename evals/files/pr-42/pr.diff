@@ -0,0 +1,12 @@
+from screener.providers import dividends
+
+
+class FakeResp:
+    def json(self):
+        return {"yield": 2.5}
+
+
+def test_fetch_yields(monkeypatch):
+    monkeypatch.setattr(dividends.guard, "request", lambda url: FakeResp())
+    assert dividends.fetch_yields(["AAA"]) == {"AAA": 2.5}
+
