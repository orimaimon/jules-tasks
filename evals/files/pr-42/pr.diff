diff --git a/screener/providers/dividends.py b/screener/providers/dividends.py
new file mode 100644
--- /dev/null
+++ b/screener/providers/dividends.py
@@ -0,0 +1,30 @@
+import json
+import os
+import time
+
+from screener import guard
+
+CACHE = os.path.join(os.path.dirname(__file__), "..", "data", "dividends.json")
+
+
+def fetch_yields(tickers):
+    out = {}
+    for t in tickers:
+        while True:
+            try:
+                r = guard.request(f"https://quotes.example.com/div?symbol={t}")
+                break
+            except Exception:
+                time.sleep(0.2)
+                continue
+        v = float(r.json()["yield"])
+        if v <= 1:
+            v = v * 100
+        out[t] = v
+    return out
+
+
+def refresh(tickers):
+    data = fetch_yields(tickers)
+    with open(CACHE, "w") as f:
+        json.dump(data, f)
